# Set these in the Netlify UI (Site configuration -> Environment variables). Never commit real values.

# Required once, for first-time admin setup at /setup. Any long random string; mark it "secret".
ADMIN_BOOTSTRAP_TOKEN=

# Optional. Defaults to 2 (the MASTER_PLAN requirement).
# MAX_ADMINS=2

# --- Local development only ---------------------------------------------------
# Netlify injects NETLIFY_DB_URL in production. Locally, point it at any Postgres 15+:
# NETLIFY_DB_URL=postgres://user:pass@localhost:5432/scheduling
# NETLIFY_DB_DRIVER=server
# LOCAL_BLOBS_DIR=.local-blobs
